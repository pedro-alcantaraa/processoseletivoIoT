{
  "version": 1,
  "author": "Pedro Henrique Rodrigues De Sá Alcantara",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": -60, "left": 150, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 100, "left": 150, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:3V3", "ldr1:VCC", "red", [] ],
    [ "esp:GND.1", "ldr1:GND", "black", [] ],
    [ "esp:34", "ldr1:AO", "green", [] ],
    [ "esp:14", "btn1:1.l", "yellow", [] ],
    [ "esp:GND.2", "btn1:2.l", "black", [] ]
  ]
}